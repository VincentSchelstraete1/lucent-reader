{
  "name": "lucent-reader",
  "displayName": "Lucent Reader",
  "version": "0.1.0",
  "description": "An assistive reading companion that simplifies difficult text so you can read and understand more comfortably",
  "author": "Vincent Schelstraete",
  "scripts": {
    "dev": "plasmo dev",
    "build": "node scripts/extension-release.mjs build",
    "package": "node scripts/extension-release.mjs package",
    "build:development": "plasmo build",
    "package:development": "plasmo package",
    "test": "node --test scripts/extension-release-config.test.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.251",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "storage",
      "sidePanel",
      "identity"
    ],
    "host_permissions": [
      "https://api.lucentreader.com/*",
      "https://lucentreader.com/*",
      "http://127.0.0.1:8000/*",
      "http://localhost:5173/*"
    ]
  }
}
