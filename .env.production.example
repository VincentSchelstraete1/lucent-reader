APP_ENV=production
LOG_LEVEL=INFO

POSTGRES_DB=lucent
POSTGRES_USER=lucent
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://lucent:replace-with-a-long-random-password@postgres:5432/lucent

PUBLIC_API_ORIGIN=https://api.lucentreader.com
API_ORIGIN=https://api.lucentreader.com
# Add the installed extension origin after its production ID is confirmed.
ALLOWED_ORIGINS=https://lucentreader.com,chrome-extension://replace-with-production-extension-id
COOKIE_SECURE=true
ENABLE_DEVELOPMENT_AUTH=false
ENABLE_LEGACY_CLAIM=false
SUPPORT_EMAIL=replace-with-monitored-support-address
POLICY_EFFECTIVE_DATE=replace-with-launch-effective-date

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://api.lucentreader.com/auth/google/callback
# Bare 32-character Chrome ID; do not include chrome-extension:// here.
LUCENT_EXTENSION_IDS=replace-with-production-extension-id

ANTHROPIC_API_KEY=replace-with-anthropic-key
ANTHROPIC_TIMEOUT_SECONDS=20
ANTHROPIC_MAX_RETRIES=1
LEARN_TUTOR_MODEL_ENABLED=1

VOYAGE_API_KEY=replace-with-voyage-key
RAG_EMBEDDING_MODEL=voyage-3-lite
RAG_EMBEDDING_DIMENSIONS=512
RAG_EMBEDDING_TIMEOUT_SECONDS=20
RAG_EMBEDDING_MAX_RETRIES=2
RAG_EMBEDDING_RETRY_BACKOFF_SECONDS=0.25
RAG_EMBEDDING_RATE_LIMIT_BACKOFF_SECONDS=1
RAG_EMBEDDING_BATCH_SIZE=32

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=15
DATABASE_POOL_RECYCLE_SECONDS=1800
PDF_UPLOAD_MAX_BYTES=20971520
PROGRESSIVE_JOB_TTL_SECONDS=1800
PROGRESSIVE_JOB_MAX_ENTRIES=200
USAGE_INGESTION_USER_LIMIT_PER_HOUR=3
USAGE_INGESTION_GLOBAL_LIMIT_PER_HOUR=30
USAGE_GENERATION_USER_LIMIT_PER_HOUR=30
USAGE_GENERATION_GLOBAL_LIMIT_PER_HOUR=120
USAGE_ASK_USER_LIMIT_PER_MINUTE=12
USAGE_ASK_GLOBAL_LIMIT_PER_MINUTE=60
USAGE_ASK_WINDOW_SECONDS=60
INGESTION_MAX_SOURCE_CHARACTERS=200000
INGESTION_MAX_PROVIDER_REQUESTS=30
