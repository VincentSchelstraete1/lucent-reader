APP_ENV=production
LOG_LEVEL=INFO

POSTGRES_DB=lucent
POSTGRES_USER=lucent
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://lucent:replace-with-a-long-random-password@postgres:5432/lucent

PUBLIC_API_ORIGIN=https://api.example.com
API_ORIGIN=https://api.example.com
ALLOWED_ORIGINS=https://app.example.com
COOKIE_SECURE=true

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://api.example.com/auth/google/callback
LUCENT_EXTENSION_IDS=chrome-extension://replace-with-production-extension-id

ANTHROPIC_API_KEY=replace-with-anthropic-key
ANTHROPIC_TIMEOUT_SECONDS=20
ANTHROPIC_MAX_RETRIES=1
LEARN_TUTOR_MODEL_ENABLED=1

VOYAGE_API_KEY=replace-with-voyage-key
RAG_EMBEDDING_MODEL=voyage-3-lite
RAG_EMBEDDING_DIMENSIONS=512
RAG_EMBEDDING_TIMEOUT_SECONDS=20
RAG_EMBEDDING_MAX_RETRIES=2
RAG_EMBEDDING_RETRY_BACKOFF_SECONDS=0.25
RAG_EMBEDDING_RATE_LIMIT_BACKOFF_SECONDS=1
RAG_EMBEDDING_BATCH_SIZE=32

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=15
DATABASE_POOL_RECYCLE_SECONDS=1800
PDF_UPLOAD_MAX_BYTES=20971520
PROGRESSIVE_JOB_TTL_SECONDS=1800
PROGRESSIVE_JOB_MAX_ENTRIES=200
