{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": [
    "node_modules"
  ],
  "include": [
    ".plasmo/index.d.ts",
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "compilerOptions": {
    "types": ["node", "chrome"],
    "moduleResolution": "bundler",
    "paths": {
      "~*": [
        "./*"
      ]
    },
    "baseUrl": ".",
    "ignoreDeprecations": "6.0"

  }
}
